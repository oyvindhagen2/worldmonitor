# AI Services (choose at least one for summaries)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Market Data (CRITICAL for Finance variant)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Economic Data (optional but recommended)
FRED_API_KEY=your_fred_api_key_here
EIA_API_KEY=your_eia_api_key_here

# Optional API Keys for additional features
CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
ACLED_ACCESS_TOKEN=your_acled_token_here
URLHAUS_AUTH_KEY=your_urlhaus_key_here
OTX_API_KEY=your_otx_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
WINGBITS_API_KEY=your_wingbits_api_key_here
AISSTREAM_API_KEY=your_aisstream_api_key_here
NASA_FIRMS_API_KEY=your_nasa_firms_api_key_here

# OpenSky (for military flight tracking)
OPENSKY_CLIENT_ID=your_opensky_client_id_here
OPENSKY_CLIENT_SECRET=your_opensky_client_secret_here

# Local LLM (optional, for desktop variant)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama2
